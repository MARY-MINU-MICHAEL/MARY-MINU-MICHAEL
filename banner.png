<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="540" viewBox="0 0 1600 540" role="img" aria-labelledby="title desc">
  <title id="title">Mary Minu Michael — GitHub profile banner</title>
  <desc id="desc">Warm, elegant banner introducing Mary Minu Michael as a data analyst focused on e-commerce and automotive data, with SQL, Python, Power BI, and Excel skills.</desc>
  <defs>
    <linearGradient id="paper" x2="0" y2="1"><stop stop-color="#f7f4ee"/><stop offset="1" stop-color="#e9e2d7"/></linearGradient>
    <linearGradient id="desk" x2="1" y2="1"><stop stop-color="#f4efe6"/><stop offset="1" stop-color="#e2d6c8"/></linearGradient>
    <linearGradient id="screen" x2="1" y2="1"><stop stop-color="#344e5d"/><stop offset="1" stop-color="#203643"/></linearGradient>
    <filter id="shadow" x="-30%" y="-30%" width="160%" height="160%"><feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#493528" flood-opacity=".16"/></filter>
    <pattern id="grain" width="120" height="120" patternUnits="userSpaceOnUse"><circle cx="8" cy="16" r="1" fill="#816d59" opacity=".09"/><circle cx="72" cy="83" r="1" fill="#816d59" opacity=".07"/><circle cx="105" cy="39" r=".8" fill="#816d59" opacity=".08"/></pattern>
  </defs>
  <rect width="1600" height="540" rx="22" fill="url(#paper)"/>
  <rect width="1600" height="540" rx="22" fill="url(#grain)"/>
  <!-- Soft sunlit shapes and desk details -->
  <circle cx="1445" cy="-18" r="230" fill="#d9e0d5" opacity=".47"/>
  <circle cx="1355" cy="515" r="255" fill="#c5d2ca" opacity=".35"/>
  <g opacity=".95" filter="url(#shadow)">
    <!-- laptop cropped into upper-left corner -->
    <g transform="rotate(-9 166 52)">
      <rect x="-70" y="-135" width="458" height="246" rx="22" fill="#b9b5ae"/>
      <rect x="-51" y="-116" width="420" height="210" rx="14" fill="url(#screen)"/>
      <g fill="#d6d0c7" opacity=".8">
        <rect x="-20" y="-87" width="48" height="14" rx="3"/><rect x="35" y="-87" width="48" height="14" rx="3"/><rect x="90" y="-87" width="48" height="14" rx="3"/><rect x="145" y="-87" width="48" height="14" rx="3"/><rect x="200" y="-87" width="48" height="14" rx="3"/><rect x="255" y="-87" width="48" height="14" rx="3"/>
        <rect x="-20" y="-64" width="48" height="14" rx="3"/><rect x="35" y="-64" width="48" height="14" rx="3"/><rect x="90" y="-64" width="48" height="14" rx="3"/><rect x="145" y="-64" width="48" height="14" rx="3"/><rect x="200" y="-64" width="48" height="14" rx="3"/><rect x="255" y="-64" width="48" height="14" rx="3"/>
        <rect x="-20" y="-41" width="48" height="14" rx="3"/><rect x="35" y="-41" width="48" height="14" rx="3"/><rect x="90" y="-41" width="48" height="14" rx="3"/><rect x="145" y="-41" width="48" height="14" rx="3"/><rect x="200" y="-41" width="48" height="14" rx="3"/><rect x="255" y="-41" width="48" height="14" rx="3"/>
      </g>
    </g>
    <!-- coffee cup -->
    <circle cx="1398" cy="89" r="83" fill="#c4a47f" opacity=".45"/>
    <circle cx="1398" cy="80" r="70" fill="#fbfaf6"/>
    <circle cx="1398" cy="80" r="52" fill="#72513e"/>
    <circle cx="1398" cy="80" r="42" fill="#34251d"/>
    <path d="M1456 65c42-7 47 58 1 67" fill="none" stroke="#fbfaf6" stroke-width="17"/>
    <!-- small plant -->
    <path d="M1510 162c-38-3-66-19-79-55 38 2 66 19 79 55Zm2 0c0-41 18-67 53-82 2 39-15 66-53 82Zm-3 3c-9-31-4-56 17-78 11 29 6 55-17 78Z" fill="#78896e"/>
  </g>
  <!-- Notebook at bottom left -->
  <g transform="rotate(8 166 498)" filter="url(#shadow)">
    <rect x="35" y="444" width="285" height="155" rx="12" fill="#fffdf9"/>
    <path d="M53 475h247M53 499h247M53 523h247" stroke="#d9cec0" stroke-width="2"/>
    <g fill="none" stroke="#b08d6d" stroke-width="3"><path d="M60 436v18m26-18v18m26-18v18m26-18v18m26-18v18m26-18v18m26-18v18m26-18v18m26-18v18"/></g>
  </g>
  <!-- Text panel -->
  <g transform="translate(405 0)">
    <text x="0" y="165" fill="#8f5d43" font-family="'Segoe Script','Brush Script MT',cursive" font-size="75" font-style="italic" letter-spacing="1">Mary Minu Michael</text>
    <path d="M2 189h540" stroke="#c2a990" stroke-width="2" opacity=".8"/>
    <text x="4" y="237" fill="#4c514e" font-family="'Segoe UI',Arial,sans-serif" font-size="27" letter-spacing=".6">DATA ANALYST</text>
    <circle cx="209" cy="228" r="3.5" fill="#a66e50"/>
    <text x="229" y="237" fill="#676760" font-family="'Segoe UI',Arial,sans-serif" font-size="23">E-commerce &amp; Automotive Data</text>
    <text x="5" y="306" fill="#72736b" font-family="'Segoe UI',Arial,sans-serif" font-size="18" letter-spacing="2.4">TURNING DATA INTO CLEARER DECISIONS</text>
    <g transform="translate(0 354)" font-family="'Segoe UI',Arial,sans-serif" font-size="19" font-weight="600">
      <g><rect width="119" height="48" rx="24" fill="#8caa91"/><text x="59.5" y="31" text-anchor="middle" fill="#fffdf7">SQL</text></g>
      <g transform="translate(132)"><rect width="143" height="48" rx="24" fill="#d19b71"/><text x="71.5" y="31" text-anchor="middle" fill="#fffdf7">Python</text></g>
      <g transform="translate(288)"><rect width="160" height="48" rx="24" fill="#7f9c98"/><text x="80" y="31" text-anchor="middle" fill="#fffdf7">Power BI</text></g>
      <g transform="translate(461)"><rect width="132" height="48" rx="24" fill="#b6a079"/><text x="66" y="31" text-anchor="middle" fill="#fffdf7">Excel</text></g>
    </g>
  </g>
  <!-- Fine frame -->
  <rect x="1.5" y="1.5" width="1597" height="537" rx="21" fill="none" stroke="#fff" stroke-opacity=".72" stroke-width="3"/>
</svg>
